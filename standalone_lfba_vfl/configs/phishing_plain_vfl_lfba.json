{
  "data_dir": "./dataset/data_raw/", // Root that contains Phishing/PHISHING_full.csv
  "dataset": "PHISHING", // Binary phishing classification dataset
  "device": 0,
  "results_dir": "./results/standalone_lfba_vfl/phishing_k3_comparable",
  "seed": 100, // Paper does not specify the seed; keep a stable default
  "epoch": 30, // Practical convergence cap for the standalone runner
  "batch_size": 256, // Paper setting
  "client_num": 3, // Comparable setting: use the same 3-client VFL split as UCIHAR
  "lr": 0.003, // Paper setting for Phishing
  "start_epoch": 0,
  "print_steps": 10,
  "early_stop": 10,
  "target_label": 1, // Default binary backdoor target label for the new phishing dataset
  "poison_rate": 0.1, // Paper uses p in the 0.1-0.3 range
  "poison_dimensions": 5, // Comparable trigger budget: 5/37 attacker-slice dims, used as the reference ratio
  "trigger_feature_clip": 1.0,
  "attack_client_num": 2, // Comparable setting: use the third client as the attacker
  "select_rate": 0.3, // Comparable poison budget: keep the same LFBA switching ratio as UCIHAR
  "random_select": false,
  "poison_all": false,
  "anchor_idx": 1000, // Local reproducible default; not fixed in the paper
  "pretrain_stage": 0,
  "mode": "train",
  "test_checkpoint": null
}
