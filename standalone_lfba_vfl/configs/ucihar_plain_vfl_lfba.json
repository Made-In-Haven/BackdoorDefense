{
  "data_dir": "./dataset/data_raw/", // UCI-HAR root used by the standalone runner
  "dataset": "UCIHAR", // Paper experiment dataset
  "device": 0, // GPU index; set to -1 to force CPU fallback in this runner
  "results_dir": "./results/standalone_lfba_vfl/ucihar_k2_paper_like",
  "seed": 100, // Paper does not specify a random seed; keep a stable local default
  "epoch": 60, // Paper says training runs until convergence; this standalone script still uses an early-stop cap
  "batch_size": 256, // Explicitly stated in the paper
  "client_num": 2, // Paper reports UCI-HAR results for K=2 and K=4; use the K=2 setting here
  "lr": 0.003, // Explicitly stated for UCI-HAR in the paper
  "start_epoch": 0,
  "print_steps": 10,
  "early_stop": 10, // Practical convergence stop for this standalone script
  "target_label": 3, // Paper says the backdoor target is the fourth class; this runner uses 0-based labels
  "poison_rate": 0.1, // Paper states p is set between 0.1 and 0.3; use the common default p=0.1
  "poison_dimensions": 120, // Paper says several dimensions are fixed as triggers; use a small trigger size
  "trigger_feature_clip": 1.0, // Fixed trigger value for vector features
  "attack_client_num": 1, // In K=2, the second client acts as the attacker
  "select_rate": 0.3, // Paper uses the switching ratio s in [0,1]; use the standard small-switch setting
  "random_select": false,
  "poison_all": false, // LFBA includes selective sample switching rather than poisoning all selected samples directly
  "anchor_idx": 1000, // Paper does not publish a fixed anchor index; keep the local reproducible choice
  "pretrain_stage": 0,
  "mode": "train",
  "test_checkpoint": null
}
