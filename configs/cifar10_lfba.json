{
  "data_dir": "./dataset/data_raw/", // CIFAR10 dataset download/cache directory
  "dataset": "CIFAR10", // Use the CIFAR10 dataset
  "device": 0, // GPU index
  "results_dir": "./results/CIFAR10_LFBA", // Output directory for logs and checkpoints
  "seed": 100, // Random seed
  "epoch": 100, // Number of training epochs
  "batch_size": 256, // Batch size
  "client_num": 2, // CIFAR10 follows the original two-client split
  "pretrained_checkpoint": null, // Do not resume from a checkpoint
  "test_checkpoint": null, // Not used in train mode
  "lr": 0.001, // Learning rate
  "start_epoch": 0, // Starting epoch
  "print_steps": 10, // Logging interval
  "early_stop": 20, // Early stopping patience
  "attack": "LFBA", // LFBA attack from the README example
  "target_label": 3, // Initial target label
  "poison_rate": 0.1, // Poison sample ratio
  "poison_dimensions": 5, // Reserved for vector datasets; kept for compatibility
  "trigger_feature_clip": 1.0, // Reserved for vector datasets; kept for compatibility
  "attack_client_num": 1, // The second client is the attacker
  "feature_extractor": "", // Reserved legacy argument
  "select_rate": 0.5, // LFBA replacement ratio from the README example
  "random_select": false, // Disable random poison sample selection
  "select_replace": true, // Enable LFBA replacement strategy
  "poison_all": false, // Do not poison every candidate sample
  "anchor_idx": 23470, // Anchor sample index from the README example
  "pretrain_stage": 0, // LFBA warmup setting
  "mode": "train", // Run training
  "defense": "none", // Match the README command: no defense
  "force_stage1_retrain": false, // Unused when defense is disabled
  "enable_anchor_loss": false, // Disable anchor loss
  "lambda_anchor": 0.0, // Zero anchor-loss weight
  "anchor_pretrain_epochs": 20, // Unused when defense is disabled
  "anchor_scale": 16.0, // Unused when defense is disabled
  "anchor_margin": 0.2, // Unused when defense is disabled
  "anchor_bank_path": "", // Do not load an anchor artifact
  "anchor_stage1_dir": "", // Do not load stage1 artifacts
  "detect_threshold": 3.0, // Unused when defense is disabled
  "majority_ratio": 0.5 // Unused when defense is disabled
}
