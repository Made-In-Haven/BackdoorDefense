{
  "data_dir": "./dataset/data_raw/", // CIFAR10 dataset download/cache directory
  "dataset": "CIFAR10", // Use the CIFAR10 dataset
  "device": 0, // GPU index
  "results_dir": "./results/AVGuard/CIFAR10_anchor_stage1_3clients", // Output directory for the 3-client stage1 run
  "seed": 100, // Random seed
  "epoch": 100, // Reserved for stage2; stage1 uses anchor_pretrain_epochs below
  "batch_size": 256, // Batch size
  "client_num": 3, // Three CIFAR10 clients
  "pretrained_checkpoint": null, // Do not resume from a checkpoint
  "test_checkpoint": null, // Not used in pretrain mode
  "lr": 0.001, // Learning rate
  "start_epoch": 0, // Starting epoch
  "print_steps": 10, // Logging interval
  "early_stop": 20, // Reserved for stage2
  "attack": "LFBA", // Keep the attack enabled so stage1 also builds the attacker branch
  "target_label": 3, // Initial target label
  "poison_rate": 0.1, // Poison sample ratio
  "poison_dimensions": 5, // Reserved for vector datasets; CIFAR10 uses an image trigger
  "trigger_feature_clip": 1.0, // Reserved for vector datasets
  "attack_client_num": 2, // The last client is the attacker
  "feature_extractor": "", // Reserved legacy argument
  "select_rate": 0.5, // Keep the README LFBA selection ratio for consistency
  "random_select": false, // Disable random poison selection
  "select_replace": true, // Keep LFBA replacement mode enabled
  "poison_all": false, // Do not poison every candidate sample
  "anchor_idx": 23470, // Anchor sample index from the CIFAR10 README example
  "pretrain_stage": 0, // LFBA warmup setting
  "mode": "pretrain_anchor", // Run only stage1
  "defense": "anchor", // Enable the stage1 anchor pretraining pipeline
  "defense_scheme": "AVGuard", // Anchor Voting Guard
  "force_stage1_retrain": true, // Always rerun stage1 when this config is used
  "enable_anchor_loss": false, // Stage1 does not use stage2 anchor loss
  "lambda_anchor": 0.0, // Stage2-only weight, kept at zero here
  "anchor_pretrain_epochs": 20, // Number of stage1 epochs
  "anchor_scale": 16.0, // ArcFace scale for the active-side private head
  "anchor_margin": 0.0, // Positive margin is disabled for narrow CIFAR10 slices
  "anchor_bank_path": "./results/AVGuard/CIFAR10_anchor_stage1_3clients/anchor_bank.pt", // Serialized stage1 anchor artifact
  "anchor_stage1_dir": "./results/AVGuard/CIFAR10_anchor_stage1_3clients/anchor_stage1", // Directory for stage1 local models and anchors
  "detect_threshold": 3.0, // Reserved for stage3
  "majority_ratio": 0.5 // Reserved for stage3
}
