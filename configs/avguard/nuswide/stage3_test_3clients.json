{
  "data_dir": "./dataset/data_raw/", // 数据集根目录
  "dataset": "NUSWIDE", // 数据集名称
  "device": 0, // GPU 编号
  "results_dir": "./results/AVGuard/NUSWIDE_anchor_stage3_3clients", // 结果输出目录
  "seed": 100, // 随机种子
  "batch_size": 256, // 批大小
  "client_num": 3, // 客户端数量
  "test_checkpoint": "./results/AVGuard/NUSWIDE_anchor_stage2_3clients/best_checkpoint.pth.tar", // 测试使用的检查点路径
  "attack": "LFBA", // 后门攻击类型
  "poison_rate": 0.1, // 投毒比例
  "poison_dimensions": 10, // 触发器维度数
  "trigger_feature_clip": 1.0, // 触发器取值或裁剪值
  "attack_client_num": 2, // 攻击客户端编号
  "select_rate": 0.3, // LFBA 样本切换比例
  "random_select": false, // 是否随机选择投毒样本
  "poison_all": false, // 是否对全部候选样本投毒
  "anchor_idx": 33930, // 锚样本索引
  "mode": "test", // 运行模式
  "defense": "anchor", // 防御类型
  "defense_scheme": "AVGuard", // 防御方案名称
  "enable_stage1": true, // 是否启用第一阶段
  "enable_anchor_loss": true, // 是否启用 anchor 损失
  "anchor_scale": 16.0, // ArcFace 缩放系数
  "anchor_margin": 0.2, // ArcFace 间隔参数
  "anchor_bank_path": "./results/AVGuard/NUSWIDE_anchor_stage1_3clients/anchor_bank.pt", // 第一阶段 anchor 工件路径
  "anchor_stage1_dir": "./results/AVGuard/NUSWIDE_anchor_stage1_3clients/anchor_stage1", // 第一阶段工件目录
  "stage3_enable_joint_weighted_voting": true, // 第三阶段是否启用联合加权投票
  "stage3_enable_static_reliability": true, // 第三阶段是否使用静态可靠性权重
  "gamma": 2.0, // 第三阶段联合投票温度系数
  "theta_supp": 0.15 // 第三阶段有效支持阈值
}
