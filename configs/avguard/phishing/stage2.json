{
  "data_dir": "./dataset/data_raw/", // Root directory that contains Phishing/PHISHING_full.csv
  "dataset": "PHISHING", // Use the phishing dataset
  "device": 0, // GPU index
  "results_dir": "./results/AVGuard/PHISHING_anchor_defense_stage2", // Output directory for stage2 logs and checkpoints
  "seed": 100, // Random seed
  "epoch": 25, // Practical stage2 training cap for PHISHING
  "batch_size": 256, // Batch size
  "client_num": 3, // Comparable setting: split PHISHING across three clients
  "pretrained_checkpoint": null, // Leave null for a fresh stage2 run
  "test_checkpoint": null, // Only used in test mode
  "lr": 0.003, // Match the phishing baseline learning rate
  "start_epoch": 0, // Starting epoch
  "print_steps": 10, // Logging interval
  "early_stop": 10, // Early stopping patience
  "attack": "LFBA", // Keep LFBA enabled during defense training
  "target_label": 1, // Binary backdoor target label for PHISHING
  "poison_rate": 0.1, // Comparable poison ratio
  "poison_dimensions": 5, // Comparable trigger budget on the attacker slice
  "trigger_feature_clip": 1.0, // Fixed-value trigger strength
  "attack_client_num": 2, // The third client is the attacker
  "feature_extractor": "", // Reserved legacy argument
  "select_rate": 0.3, // Comparable LFBA replacement ratio
  "random_select": false, // Disable random poison sample selection
  "select_replace": true, // Enable LFBA replacement strategy
  "poison_all": false, // Do not poison all candidate samples
  "anchor_idx": 1000, // Local reproducible anchor index
  "pretrain_stage": 0, // LFBA warmup setting
  "mode": "train", // Run stage2 joint training
  "defense": "anchor", // Enable anchor-based backdoor defense
  "defense_scheme": "AVGuard", // Anchor Voting Guard
  "force_stage1_retrain": false, // Reuse stage1 artifacts when they already exist
  "enable_anchor_loss": true, // Apply anchor constraint loss in stage2
  "lambda_anchor": 2.0, // Current stage2 anchor-loss weight
  "lambda_stage1_anchor": 0.8, // Current stage1 anchor-loss weight used with this run family
  "anchor_pretrain_epochs": 30, // Used only if stage1 artifacts are missing and stage1 is rerun
  "anchor_scale": 16.0, // ArcFace scale; should match stage1
  "anchor_margin": 0.45, // ArcFace margin; should match stage1
  "anchor_bank_path": "./results/AVGuard/PHISHING_anchor_defense_stage1/anchor_artifact.pt", // Fallback stage1 anchor artifact
  "anchor_stage1_dir": "./results/AVGuard/PHISHING_anchor_defense_stage1/anchor_stage1", // Preferred stage1 artifact directory
  "detect_threshold": 2.0, // Reserved compatibility field; current stage3 vote logic does not use it
  "detect_threshold_cap": 1.5, // Reserved compatibility field
  "majority_ratio": 0.5 // Majority vote threshold for stage3
}
