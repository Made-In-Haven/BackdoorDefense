{
  "data_dir": "./dataset/data_raw/", // Root directory that contains Phishing/PHISHING_full.csv
  "dataset": "PHISHING", // Use the phishing dataset
  "device": 0, // GPU index
  "results_dir": "./results/AVGuard/PHISHING_anchor_defense_stage3", // Output directory for stage3 evaluation logs
  "seed": 100, // Random seed
  "epoch": 25, // Reserved for compatibility; not used in test mode
  "batch_size": 256, // Batch size
  "client_num": 3, // Comparable setting: split PHISHING across three clients
  "pretrained_checkpoint": null, // Not used in test mode
  "test_checkpoint": "./results/AVGuard/PHISHING_anchor_defense_stage2/best_checkpoint.pth.tar", // Best stage2 checkpoint for evaluation
  "lr": 0.003, // Match the phishing baseline learning rate
  "start_epoch": 0, // Reserved for compatibility
  "print_steps": 10, // Logging interval
  "early_stop": 10, // Reserved for compatibility
  "attack": "LFBA", // Keep LFBA enabled so ASR evaluation and stage3 detection are both available
  "target_label": 1, // Binary backdoor target label for PHISHING
  "poison_rate": 0.1, // Comparable poison ratio
  "poison_dimensions": 5, // Comparable trigger budget on the attacker slice
  "trigger_feature_clip": 1.0, // Fixed-value trigger strength
  "attack_client_num": 2, // The third client is the attacker
  "feature_extractor": "", // Reserved legacy argument
  "select_rate": 0.3, // Comparable LFBA replacement ratio
  "random_select": false, // Disable random poison sample selection
  "select_replace": true, // Enable LFBA replacement strategy
  "poison_all": false, // Do not poison all candidate samples
  "anchor_idx": 1000, // Local reproducible anchor index
  "pretrain_stage": 0, // LFBA warmup setting
  "mode": "test", // Run stage2/stage3 evaluation only
  "defense": "anchor", // Enable anchor-based defense during evaluation
  "defense_scheme": "AVGuard", // Anchor Voting Guard
  "force_stage1_retrain": false, // Never rerun stage1 in test mode
