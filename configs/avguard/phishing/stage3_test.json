  "lambda_anchor": 1.0, // Kept for compatibility in test mode
  "lambda_stage1_anchor": 0.3, // Kept for compatibility in test mode
  "anchor_pretrain_epochs": 20, // Kept for compatibility in test mode
  "anchor_scale": 16.0, // Must match stage1
  "anchor_margin": 0.2, // Must match stage1
  "anchor_bank_path": "./results/AVGuard/AVGuard/PHISHING_anchor_defense_stage1/anchor_artifact.pt", // Fallback stage1 anchor artifact
  "anchor_stage1_dir": "./results/AVGuard/PHISHING_anchor_defense_stage1/anchor_stage1", // Preferred stage1 artifact directory
  "detect_threshold": 1.2, // Reserved compatibility field
  "detect_threshold_cap": 2.0, // Reserved compatibility field
  "majority_ratio": 0.5 // Majority vote threshold for stage3
}
